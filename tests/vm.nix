# Boots a NixOS VM whose configuration imports a module generated by
# lazyflakes and checks that its packages are installed. Run through
# `LAZYFLAKES_E2E=1 LAZYFLAKES_VM=1 go test -run VirtualMachine`.
{ module, pkgs ? import <nixpkgs> { } }:

pkgs.testers.runNixOSTest {
  name = "lazyflakes-module";
  # Test nodes share a read-only pkgs by default; the module may set
  # nixpkgs.config (allow unfree), so the node builds its own.
  node.pkgsReadOnly = false;
  nodes.machine = { imports = [ module ]; };
  testScript = ''
    machine.wait_for_unit("multi-user.target")
    machine.succeed("hello --version")
    machine.succeed("test -x /run/current-system/sw/bin/unrar")
  '';
}
